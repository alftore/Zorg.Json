<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- net11.0 also checks C# unions and the new number types. -->
    <TargetFramework></TargetFramework>
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <LangVersion Condition="'$(TargetFramework)' == 'net11.0'">15.0</LangVersion>
    <PublishAot>true</PublishAot>
    <!-- Report each trim and AOT warning, not one summary warning per assembly. -->
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
    <VerifyReferenceAotCompatibility>true</VerifyReferenceAotCompatibility>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Zorg.Json.Extensions.AI\Zorg.Json.Extensions.AI.csproj" />
    <ProjectReference Include="..\..\src\Zorg.Json.Llm\Zorg.Json.Llm.csproj" />
    <ProjectReference Include="..\..\src\Zorg.Json\Zorg.Json.csproj" />
    <ProjectReference Include="..\..\src\Zorg.Json.SourceGeneration\Zorg.Json.SourceGeneration.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
