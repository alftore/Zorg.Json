<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Fluent, Zod-inspired JSON Schema generation and validation for .NET.</Description>
    <PackageTags>json;json-schema;validation;zod;system-text-json</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Zorg.Json.Tests" />
    <InternalsVisibleTo Include="Zorg.Json.ComplianceTests" />
    <InternalsVisibleTo Include="Zorg.Json.AspNetCore" />
    <InternalsVisibleTo Include="Zorg.Json.Llm" />
  </ItemGroup>

  <!-- The generator ships in this package, as the one of System.Text.Json does, so [GenerateSchema] needs nothing else. -->
  <ItemGroup>
    <ProjectReference Include="..\Zorg.Json.SourceGeneration\Zorg.Json.SourceGeneration.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <None Include="..\Zorg.Json.SourceGeneration\bin\$(Configuration)\netstandard2.0\Zorg.Json.SourceGeneration.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
  </ItemGroup>

</Project>
