<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>ASP.NET Core integration for Zorg.Json: validate request bodies, return RFC 9457 problem details and serve JSON Schema documents.</Description>
    <PackageTags>json;json-schema;validation;zod;aspnetcore;minimal-api;problem-details</PackageTags>
    <!-- The shared framework's reference assemblies don't carry the attribute this checks. samples/Zorg.Json.AspNetCore.AotSmoke publishes for real instead. -->
    <VerifyReferenceAotCompatibility>false</VerifyReferenceAotCompatibility>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Zorg.Json\Zorg.Json.csproj" />
  </ItemGroup>

</Project>
