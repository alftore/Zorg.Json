<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Lambdas passed to Map methods compile through the Request Delegate Generator, the Native AOT path.
         A handler typed as Delegate can't be intercepted, so those tests take the runtime path (RDG002 is that notice). -->
    <EnableRequestDelegateGenerator>true</EnableRequestDelegateGenerator>
    <NoWarn>$(NoWarn);RDG002</NoWarn>
    <!-- Requests go to an in-memory server, so cancelling them buys nothing. -->
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.AspNetCore.TestHost" />
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Zorg.Json.AspNetCore.OpenApi\Zorg.Json.AspNetCore.OpenApi.csproj" />
    <ProjectReference Include="..\..\src\Zorg.Json.AspNetCore\Zorg.Json.AspNetCore.csproj" />
    <ProjectReference Include="..\..\src\Zorg.Json\Zorg.Json.csproj" />
  </ItemGroup>

</Project>
