<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Both builds of Zorg.Json. -->
    <TargetFramework></TargetFramework>
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <!-- The net11.0 tests declare C# 15 unions. -->
    <LangVersion Condition="'$(TargetFramework)' == 'net11.0'">15.0</LangVersion>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="JsonSchema.Net" />
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Zorg.Json\Zorg.Json.csproj" />
    <ProjectReference Include="..\..\src\Zorg.Json.Llm\Zorg.Json.Llm.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="suite-manifest.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Fixtures\*.json" Link="Fixtures\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\tools\zod-compare\known-differences.json" Link="Fixtures\known-differences.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyMetadata Include="JsonSchemaTestSuitePath" Value="$(MSBuildProjectDirectory)\JSON-Schema-Test-Suite" />
    <AssemblyMetadata Include="ZodFixturesPath" Value="$(MSBuildProjectDirectory)\Fixtures" />
    <AssemblyMetadata Include="ZodToolPath" Value="$(MSBuildProjectDirectory)\..\..\tools\zod-compare" />
  </ItemGroup>

</Project>
