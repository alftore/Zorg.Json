<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Both builds of Zorg.Json. -->
    <TargetFramework></TargetFramework>
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <!-- The net11.0 tests declare C# 15 unions. -->
    <LangVersion Condition="'$(TargetFramework)' == 'net11.0'">15.0</LangVersion>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Zorg.Json\Zorg.Json.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyMetadata Include="SnapshotPath" Value="$(MSBuildProjectDirectory)\Snapshots" />
  </ItemGroup>

</Project>
