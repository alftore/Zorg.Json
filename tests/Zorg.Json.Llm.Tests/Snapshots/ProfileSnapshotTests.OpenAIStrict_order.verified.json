{
  "description": "A customer order",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "customer": {
      "type": "object",
      "properties": {
        "name": {
          "description": "Must also satisfy: minLength 1; maxLength 100.",
          "type": "string"
        },
        "email": {
          "type": [
            "string",
            "null"
          ],
          "format": "email"
        },
        "nickname": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "name",
        "email",
        "nickname"
      ],
      "additionalProperties": false
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "paid",
        "shipped"
      ]
    },
    "quantity": {
      "type": "integer",
      "minimum": 1,
      "maximum": 99
    },
    "price": {
      "type": "number",
      "exclusiveMinimum": 0,
      "multipleOf": 0.01
    },
    "priority": {
      "description": "Default: 3.",
      "type": [
        "integer",
        "null"
      ]
    },
    "note": {
      "type": [
        "string",
        "null"
      ]
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "maxItems": 5
    },
    "category": {
      "type": "object",
      "properties": {
        "name": {
          "description": "Must also satisfy: minLength 1.",
          "type": "string"
        },
        "children": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#/$defs/category"
          }
        }
      },
      "required": [
        "name",
        "children"
      ],
      "additionalProperties": false
    },
    "code": {
      "description": "Refinement: The code must have an even length",
      "type": "string",
      "pattern": "^Z[0-9]+$"
    }
  },
  "required": [
    "id",
    "customer",
    "status",
    "quantity",
    "price",
    "priority",
    "note",
    "tags",
    "category",
    "code"
  ],
  "additionalProperties": false,
  "$defs": {
    "category": {
      "type": "object",
      "properties": {
        "name": {
          "description": "Must also satisfy: minLength 1.",
          "type": "string"
        },
        "children": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#/$defs/category"
          }
        }
      },
      "required": [
        "name",
        "children"
      ],
      "additionalProperties": false
    }
  }
}