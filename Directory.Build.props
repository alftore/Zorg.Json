<Project>
  <PropertyGroup>
    <!-- Language and framework -->
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>

    <!-- Quality gates. GenerateDocumentationFile stays on in every project: IDE0005 needs it at build. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <MSBuildTreatWarningsAsErrors>true</MSBuildTreatWarningsAsErrors>
    <AnalysisLevel>latest-all</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Features>strict</Features>

    <!-- In a net11.0 build, CA1307 and CA2263 suggest overloads that are new in .NET 11, such as StartsWith(char, StringComparison)
         and GetTypeInfo<T>(), so the shared code can't take them. A char compares ordinally anyway. The net10.0 build keeps both rules. -->
    <NoWarn Condition="'$(TargetFramework)' == 'net11.0'">$(NoWarn);CA1307;CA2263</NoWarn>

    <!-- Determinism -->
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true' or '$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>

    <!-- Packaging metadata -->
    <VersionPrefix>0.1.1</VersionPrefix>
    <Authors>Zorg.Json contributors</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/alftore/Zorg.Json</PackageProjectUrl>
    <PackageReleaseNotes>https://github.com/alftore/Zorg.Json/blob/main/CHANGELOG.md</PackageReleaseNotes>
    <RepositoryUrl>https://github.com/alftore/Zorg.Json.git</RepositoryUrl>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <IsPackable>false</IsPackable>

    <!-- Relative to the repo root, so a checkout path that contains "src" or "tests" can't change the result. -->
    <ZorgProjectPath>$([MSBuild]::MakeRelative($(MSBuildThisFileDirectory), $(MSBuildProjectDirectory)))</ZorgProjectPath>
  </PropertyGroup>

  <!-- Library projects (src/) -->
  <PropertyGroup Condition="$(ZorgProjectPath.StartsWith('src'))">
    <IsPackable>true</IsPackable>
    <IsAotCompatible>true</IsAotCompatible>
    <VerifyReferenceAotCompatibility>true</VerifyReferenceAotCompatibility>
    <EnablePackageValidation>true</EnablePackageValidation>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsPackable)' == 'true'">
    <None Include="$(MSBuildThisFileDirectory)PACKAGE.md" Pack="true" PackagePath="README.md" />
  </ItemGroup>
</Project>
