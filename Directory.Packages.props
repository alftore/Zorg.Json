<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <!-- The core has no package dependencies: System.Text.Json is in the net10.0 shared framework. -->
  <ItemGroup Label="Tests">
    <!-- Test oracle only: its binaries carry a maintenance-fee agreement. -->
    <PackageVersion Include="JsonSchema.Net" Version="9.6.0" />
    <PackageVersion Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.12.0" />
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
  </ItemGroup>

  <ItemGroup Label="Benchmarks">
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
  </ItemGroup>
</Project>
