<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <!-- The core has no package dependencies: System.Text.Json is in the net10.0 shared framework. -->
  <ItemGroup Label="OpenApi">
    <!-- Not in the shared framework, which is why Zorg.Json.AspNetCore.OpenApi is its own package.
         It's built once per major version: 11 moved to Microsoft.OpenApi 3.x, which isn't binary compatible with the 2.x of 10. -->
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.14" Condition="'$(TargetFramework)' != 'net11.0'" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="11.0.0" Condition="'$(TargetFramework)' == 'net11.0'" />
  </ItemGroup>

  <ItemGroup Label="Extensions.AI">
    <!-- Only the abstractions: no provider package, and no client. -->
    <PackageVersion Include="Microsoft.Extensions.AI.Abstractions" Version="10.11.0" />
  </ItemGroup>

  <ItemGroup Label="SourceGeneration">
    <!-- Sets the oldest compiler the generator runs on. It ships with the generator as a build-time reference only. -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
  </ItemGroup>

  <ItemGroup Label="Tests">
    <!-- Test oracle only: its binaries carry a maintenance-fee agreement. -->
    <PackageVersion Include="JsonSchema.Net" Version="9.6.0" />
    <!-- Test only: its OpenAI adapter rewrites a supplied schema, and the tests send ours through it to a fake HTTP handler. -->
    <PackageVersion Include="Microsoft.Extensions.AI" Version="10.11.0" />
    <PackageVersion Include="Microsoft.Extensions.AI.OpenAI" Version="10.11.0" />
    <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="10.0.14" Condition="'$(TargetFramework)' != 'net11.0'" />
    <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="11.0.0" Condition="'$(TargetFramework)' == 'net11.0'" />
    <PackageVersion Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.12.0" />
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
  </ItemGroup>

  <ItemGroup Label="Benchmarks">
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
  </ItemGroup>
</Project>
